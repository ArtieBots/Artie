# Doxyfile for the Artie CAN Library.
#
# This is a minimal Doxyfile -- any setting not listed here just uses Doxygen's built-in default.
# It is not meant to be run directly with `doxygen Doxyfile.in`; CMake substitutes the @...@
# placeholders below and writes the result to the build directory (see CMakeLists.txt, target
# `artie_can_docs`). To regenerate docs, build the artie-can library with BUILD_DOCS=ON
# (the default), e.g. via build_and_test_c.ps1.

PROJECT_NAME           = "Artie CAN Library"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "C library implementing the Artie CAN protocol suite (RTACP, BWACP, PSACP, RPCACP)"
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@

# Pull the top-level overview from the README and use it as the docs' front page.
INPUT                  = @DOXYGEN_README@ @DOXYGEN_INPUT_DIR@
USE_MDFILE_AS_MAINPAGE = @DOXYGEN_README@
RECURSIVE              = YES
FILE_PATTERNS          = *.h
EXCLUDE_PATTERNS       = */build/*

# Only document things that actually have a documentation comment, so gaps in coverage are
# obvious (missing from the docs) rather than papered over with bare declarations.
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
QUIET                  = YES
