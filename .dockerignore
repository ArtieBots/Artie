# The firmware images use the repo root as their Docker build context (see
# framework/artietool/tasks/build-tasks/fw/*.yaml, build-context: "../../../..").
# Keep that context small: those builds only COPY artie-common/firmware/*/src
# and framework/ardk/firmware/libraries.
.git
.continue
.vscode
build-artifacts
test-results
tmp
telemetry-example
rpyc-examples
**/__pycache__
**/*.egg-info
**/artie-tool*.txt
**/testlog-*.txt
artie-common/firmware/*/src/build
